{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunday Stride",
  "version": "1.0.0",
  "identifier": "com.sundaystride.racetiming",
  "build": {
    "beforeDevCommand": "npm run dev --workspace frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sunday Stride · Race Timing",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: tauri:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://127.0.0.1:* ws://127.0.0.1:* https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' asset: tauri: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../backend/desktop-runtime/src/": "backend-runtime/src/",
      "../backend/desktop-runtime/node_modules/": "backend-runtime/node_modules/",
      "../frontend/dist/": "public-frontend/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
